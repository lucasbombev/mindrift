# Porta e interface de rede (0.0.0.0 = acessível pelo celular na LAN)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
TZ=America/Fortaleza

# HTTPS opcional (PWA no celular). Rode "npm run cert" antes.
HTTPS_PORT=3443
# HTTPS_CERT=certs/server.crt
# HTTPS_KEY=certs/server.key

# Segredos gerados automaticamente pelo "npm start" se estiverem vazios.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Caminhos relativos à pasta backend/ (ou absolutos)
DB_PATH=data/drift.db
UPLOAD_DIR=uploads
BACKUP_DIR=backups

# Sessão
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=10

# Backup automático (hora local) e retenção
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30

# Upload de foto (MB)
MAX_UPLOAD_MB=6

# Superadmin criado no primeiro seed (troque a senha no primeiro acesso).
# Só é usado quando ainda não existe nenhum usuário superadmin.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_NAME=Superadministrador
SUPERADMIN_EMAIL=

# Coloque 1 apenas se estiver atrás de um proxy reverso
TRUST_PROXY=0
