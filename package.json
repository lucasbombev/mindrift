{
  "name": "drift-rent",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS local (LAN) para gestão de aluguel de carrinhos de drift",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
