# Copie para .env e troque os segredos antes de usar Docker:
#   cp .env.docker.example .env
#   openssl rand -hex 32   (gere um valor para cada segredo)
#
# Este arquivo é lido pelo docker-compose para interpolar as variáveis.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-48-bytes
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-de-48-bytes
TZ=America/Fortaleza
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=30d
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30
